{
  "name": "arcanora",
  "version": "1.0.0",
  "description": "Arcanora — Discord MMORPG Bot",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@arcanora/web",
    "dev:all": "turbo run dev",
    "dev:bot": "turbo run dev --filter=@arcanora/bot",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "test:vitest": "vitest run",
    "start": "node dist/index.js",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@napi-rs/canvas": "^1.0.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.36.4",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^8.21.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "turbo": "^2.0.0",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}

{
  "name": "arcanora",
  "version": "1.0.0",
  "description": "Arcanora — Discord MMORPG Bot",
  "main": "dist/index.js",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "start": "node dist/index.js",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1",
    "zod": "^3.24.1",
    "pino": "^8.21.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "drizzle-kit": "^0.30.1",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/node-cron": "^3.0.11"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^1.6.0",
    "eslint": "^8.57.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}

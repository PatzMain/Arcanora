# Discord (required)
# Get these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Database (required)
# For Railway: copy the PostgreSQL "Connection URL" from your DB service
# For local:   postgresql://user:password@localhost:5432/arcanora
DATABASE_URL=postgresql://user:password@localhost:5432/arcanora

# App
NODE_ENV=development
LOG_LEVEL=info

# Database pool tuning (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cache TTL in seconds (optional)
CACHE_TTL_SECONDS=300
